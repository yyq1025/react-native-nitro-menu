{
  "git": {
    "requireBranch": "main",
    "commit": true,
    "commitMessage": "chore: release ${version}",
    "tag": true,
    "tagName": "${version}",
    "push": false
  },
  "github": {
    "release": true,
    "releaseName": "${version}"
  },
  "npm": {
    "publish": true
  },
  "hooks": {
    "after:bump": ["bunx auto-changelog --package", "git add CHANGELOG.md package.json"]
  }
}
