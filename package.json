{
  "name": "@yyq1025/react-native-nitro-menu",
  "version": "0.1.0",
  "description": "Native iOS & Android menus — tap menus and long-press context menus with a working lift preview — built with Nitro Modules. Fork of react-native-nitro-contextmenu.",
  "main": "lib/index",
  "module": "lib/index",
  "types": "lib/index.d.ts",
  "react-native": "src/index",
  "source": "src/index",
  "files": [
    "src",
    "react-native.config.js",
    "lib",
    "nitrogen",
    "android/build.gradle",
    "android/gradle.properties",
    "android/fix-prefab.gradle",
    "android/CMakeLists.txt",
    "android/src",
    "ios/**/*.h",
    "ios/**/*.m",
    "ios/**/*.mm",
    "ios/**/*.cpp",
    "ios/**/*.swift",
    "app.plugin.js",
    "nitro.json",
    "*.podspec",
    "README.md"
  ],
  "workspaces": [
    "example"
  ],
  "scripts": {
    "clean": "git clean -dfX",
    "format": "bunx biome check --write --no-errors-on-unmatched .",
    "typecheck": "tsc --noEmit",
    "build": "bun run typecheck && bob build",
    "release": "bunx release-it",
    "codegen": "nitrogen --logLevel=\"debug\" && bun run build"
  },
  "keywords": [
    "react-native",
    "nitro",
    "contextmenu",
    "context-menu",
    "popup-menu",
    "ios",
    "android"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yyq1025/react-native-nitro-menu.git"
  },
  "author": "Yueqian Yang <yangyueqian1025@gmail.com>",
  "contributors": [
    "Spencer Pope <spencer@thepope.dev> (original author of react-native-nitro-contextmenu)"
  ],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/yyq1025/react-native-nitro-menu/issues"
  },
  "homepage": "https://github.com/yyq1025/react-native-nitro-menu#readme",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.15",
    "@commitlint/config-conventional": "^20.4.1",
    "@types/react": "^19.1.03",
    "auto-changelog": "^2.5.0",
    "commitlint": "^20.4.1",
    "lefthook": "^2.1.1",
    "nitrogen": "^0.35.4",
    "react": "19.2.0",
    "react-native": "0.83.0",
    "react-native-builder-bob": "^0.40.18",
    "react-native-nitro-modules": "^0.35.4",
    "typescript": "^5.8.3"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": "*",
    "react-native-nitro-modules": "*"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      "commonjs",
      "module",
      [
        "typescript",
        {
          "project": "tsconfig.json"
        }
      ]
    ]
  }
}
